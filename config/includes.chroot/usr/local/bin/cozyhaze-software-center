#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
CozyHaze Software Center
Grafischer Softwaremanager für CozyHaze OS Ultimate.
Verwaltet Core-Pakete, 1-Klick-Softwareprofile und Ultimate Extras.
"""

import os
import sys
import json
import subprocess
import shutil

try:
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, Gdk, GLib
    HAS_GTK = True
except (ImportError, ValueError):
    HAS_GTK = False

BASE_DIR = "/usr/share/cozyhaze"
if not os.path.exists(BASE_DIR):
    BASE_DIR = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "packages"))

CSS_STYLING = b"""
window {
    background-color: #0F1117;
    color: #E2E8F0;
    font-family: 'Segoe UI', 'Roboto', 'Inter', 'Ubuntu', sans-serif;
}
headerbar {
    background: #181B22;
    border-bottom: 1px solid #232731;
    color: #FFFFFF;
}
.card {
    background-color: #181B22;
    border: 1px solid #232731;
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 8px;
}
button.suggested-action {
    background: linear-gradient(135deg, #00C6FF, #0072FF);
    color: white;
    font-weight: bold;
    border-radius: 6px;
    border: none;
    padding: 6px 14px;
}
button.suggested-action:hover {
    background: linear-gradient(135deg, #00E5FF, #0084FF);
}
"""

def load_json_file(filename):
    paths = [
        os.path.join(BASE_DIR, filename),
        os.path.join(os.path.dirname(__file__), "..", "packages", filename)
    ]
    for p in paths:
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception:
                pass
    return {}

def is_pkg_installed(pkg_name):
    try:
        res = subprocess.run(["dpkg", "-s", pkg_name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return res.returncode == 0
    except Exception:
        return False

if HAS_GTK:
    class CozyHazeSoftwareCenter(Gtk.Window):
        def __init__(self):
            super().__init__(title="CozyHaze Software Center")
            self.set_default_size(980, 680)
            self.set_position(Gtk.WindowPosition.CENTER)

            css_provider = Gtk.CssProvider()
            css_provider.load_from_data(CSS_STYLING)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), css_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

            header = Gtk.HeaderBar()
            header.set_show_close_button(True)
            header.props.title = "CozyHaze Software Center"
            header.props.subtitle = "Ultimate Software-Ökosystem & Profile"
            self.set_titlebar(header)

            main_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
            self.add(main_box)

            self.stack = Gtk.Stack()
            self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)

            sidebar = Gtk.StackSidebar()
            sidebar.set_stack(self.stack)
            sidebar.set_size_request(220, -1)
            main_box.pack_start(sidebar, False, False, 0)
            main_box.pack_start(self.stack, True, True, 0)

            self.build_profiles_page()
            self.build_extras_page()
            self.build_updates_page()
            self.show_all()

        def create_scrollable_page(self, title):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
            box.set_border_width(20)

            lbl = Gtk.Label()
            lbl.set_markup(f"<span size='x-large' weight='bold' color='#00F2FE'>{title}</span>")
            lbl.set_xalign(0)
            box.pack_start(lbl, False, False, 0)

            scrolled = Gtk.ScrolledWindow()
            scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scrolled.add(box)
            return box, scrolled

        def build_profiles_page(self):
            box, scrolled = self.create_scrollable_page("Software-Profile (1-Klick Installation)")
            desc = Gtk.Label(label="Wählen Sie ein abgestimmtes Profil für Ihren primären Einsatzzweck. Die Core-Pakete werden konfliktfrei eingerichtet.", xalign=0)
            box.pack_start(desc, False, False, 0)

            data = load_json_file("profiles.json")
            for prof in data.get("profiles", []):
                card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
                card.get_style_context().add_class("card")

                icon = Gtk.Image.new_from_icon_name(prof.get("icon", "package-x-generic"), Gtk.IconSize.DIALOG)
                card.pack_start(icon, False, False, 0)

                vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                name_lbl = Gtk.Label()
                name_lbl.set_markup(f"<span size='large' weight='bold'>{prof.get('name_de', prof['name'])}</span>")
                name_lbl.set_xalign(0)
                vbox.pack_start(name_lbl, False, False, 0)

                desc_lbl = Gtk.Label(label=prof.get("description", ""), xalign=0)
                desc_lbl.set_line_wrap(True)
                vbox.pack_start(desc_lbl, False, False, 0)

                card.pack_start(vbox, True, True, 0)

                btn = Gtk.Button(label="Profil anwenden")
                btn.get_style_context().add_class("suggested-action")
                btn.connect("clicked", lambda w, p=prof: self.install_profile(p))
                card.pack_end(btn, False, False, 0)

                box.pack_start(card, False, False, 0)

            self.stack.add_titled(scrolled, "profiles", "Software-Profile")

        def build_extras_page(self):
            box, scrolled = self.create_scrollable_page("Ultimate Extras (Zusatzanwendungen)")
            desc = Gtk.Label(label="Große oder spezialisierte Werkzeuge, die auf Wunsch mit einem Klick nachinstalliert werden.", xalign=0)
            box.pack_start(desc, False, False, 0)

            data = load_json_file("extras.json")
            for extra in data.get("extras", []):
                card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
                card.get_style_context().add_class("card")

                vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                title = Gtk.Label()
                title.set_markup(f"<span size='large' weight='bold'>{extra['name']}</span> <span color='#00E676'>({extra['category']})</span>")
                title.set_xalign(0)
                vbox.pack_start(title, False, False, 0)

                desc_lbl = Gtk.Label(label=extra.get("description", ""), xalign=0)
                desc_lbl.set_line_wrap(True)
                vbox.pack_start(desc_lbl, False, False, 0)

                hw_lbl = Gtk.Label()
                hw_lbl.set_markup(f"<span size='small' color='#94A3B8'>{extra.get('hw_compat', '')}</span>")
                hw_lbl.set_xalign(0)
                vbox.pack_start(hw_lbl, False, False, 0)

                card.pack_start(vbox, True, True, 0)

                btn = Gtk.Button(label="Installieren")
                btn.get_style_context().add_class("suggested-action")
                btn.connect("clicked", lambda w, e=extra: self.install_extra(e))
                card.pack_end(btn, False, False, 0)

                box.pack_start(card, False, False, 0)

            self.stack.add_titled(scrolled, "extras", "Ultimate Extras")

        def build_updates_page(self):
            box, scrolled = self.create_scrollable_page("Systemaktualisierungen & Repositories")
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            card.get_style_context().add_class("card")

            card.pack_start(Gtk.Label(label="Aktualisieren Sie CozyHaze OS sicher über die offiziellen Debian 13 Quellen.", xalign=0), False, False, 0)
            
            btn_upd = Gtk.Button(label="Paketlisten aktualisieren (apt update)")
            btn_upd.connect("clicked", self.run_apt_update)
            card.pack_start(btn_upd, False, False, 0)

            btn_upg = Gtk.Button(label="Vollständiges System-Upgrade durchführen")
            btn_upg.get_style_context().add_class("suggested-action")
            btn_upg.connect("clicked", self.run_apt_upgrade)
            card.pack_start(btn_upg, False, False, 0)

            box.pack_start(card, False, False, 0)
            self.stack.add_titled(scrolled, "updates", "Aktualisierungen")

        def launch_terminal_cmd(self, cmd):
            terms = ["xfce4-terminal", "x-terminal-emulator", "xterm"]
            term_bin = next((t for t in terms if shutil.which(t)), None)
            if term_bin:
                subprocess.Popen([term_bin, "-e", f"sh -c '{cmd}; echo \"Fertig. Druecken Sie Enter zum Schliessen.\"; read _'"])
            else:
                subprocess.Popen(["pkexec", "sh", "-c", cmd])

        def install_profile(self, profile):
            pkgs = " ".join(profile.get("packages", []))
            cmd = f"sudo apt-get update && sudo apt-get install -y {pkgs}"
            self.launch_terminal_cmd(cmd)

        def install_extra(self, extra):
            itype = extra.get("install_type")
            if itype == "apt" and "apt_pkg" in extra:
                cmd = f"sudo apt-get update && sudo apt-get install -y {extra['apt_pkg']}"
            elif itype == "flatpak" and "flatpak_id" in extra:
                cmd = f"flatpak install -y flathub {extra['flatpak_id']}"
            elif itype == "pipx" and "cmd" in extra:
                cmd = extra['cmd']
            else:
                cmd = f"sudo apt-get update && sudo apt-get install -y {extra.get('apt_pkg', extra['id'])}"
            self.launch_terminal_cmd(cmd)

        def run_apt_update(self, widget):
            self.launch_terminal_cmd("sudo apt-get update")

        def run_apt_upgrade(self, widget):
            self.launch_terminal_cmd("sudo apt-get update && sudo apt-get dist-upgrade -y")

def main():
    if HAS_GTK and "DISPLAY" in os.environ:
        app = CozyHazeSoftwareCenter()
        Gtk.main()
    else:
        print("CozyHaze Software Center benötigt eine grafische X11/Xfce-Umgebung.")

if __name__ == "__main__":
    main()

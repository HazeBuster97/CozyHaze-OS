#!/bin/sh
# CozyHaze OS - GRUB Hook für Apple MacBookPro8,2 GMUX Umschaltung
# Pfad im System: /etc/grub.d/06_cozyhaze_gmux
#
# Dieser Hook schaltet beim Booten die GMUX-Hardwareports um:
# - Schaltet die Videoausgabe des internen LVDS-Panels auf die Intel HD 3000 iGPU um.
# - Trennt die Stromzufuhr zur defekten AMD Radeon dGPU.
# Dadurch bootet das MacBookPro8,2 zuverlässig ohne Gray/Black-Screen,
# selbst wenn ein PRAM/NVRAM-Reset durchgeführt wurde.

set -e

# Prüfen, ob wir uns auf einem Apple MacBookPro8,2 oder kompatiblen System befinden
IS_MBP82=0
if [ -r /sys/class/dmi/id/product_name ]; then
    PRODUCT_NAME=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
    if [ "$PRODUCT_NAME" = "MacBookPro8,2" ] || [ "$PRODUCT_NAME" = "MacBookPro8,3" ]; then
        IS_MBP82=1
    fi
else
    # Während des Live-ISO-Builds oder wenn DMI nicht lesbar ist: standardmäßig aktivieren
    IS_MBP82=1
fi

# Wenn die Umgebungsvariable FORCE_COZYHAZE_GMUX gesetzt ist, immer aktivieren
if [ "${COZYHAZE_FORCE_GMUX:-1}" = "1" ] || [ "$IS_MBP82" = "1" ]; then
    cat << 'EOF'
# --- CozyHaze OS: Apple GMUX Intel HD 3000 Hardware Switch ---
# Schaltet die Display-Bridge auf Intel iGPU und trennt Strom der defekten Radeon GPU
if [ "${grub_platform}" = "efi" ] || [ "${grub_platform}" = "pc" ]; then
    outb 0x728 1
    outb 0x710 2
    outb 0x740 2
    outb 0x750 0
fi
# -------------------------------------------------------------
EOF
fi

exit 0

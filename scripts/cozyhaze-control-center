#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
CozyHaze Control Center Ultimate
Die zentrale System-, Sicherheits- und Hardwareverwaltung für CozyHaze OS auf MacBook Pro 2011.
Erweitert um UFW-Firewall, AppArmor, Diensteverwaltung, Autostart und Sicherheits-Audits.
"""

import os
import sys
import subprocess
import shutil
import platform
import glob

try:
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, Gdk, GLib
    HAS_GTK = True
except (ImportError, ValueError):
    HAS_GTK = False


# ==============================================================================
# Systemabfrage-Hilfsfunktionen
# ==============================================================================

def run_cmd(cmd_list, timeout=10):
    try:
        res = subprocess.run(cmd_list, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout)
        return res.stdout.strip()
    except Exception:
        return ""

def get_dmi_info():
    info = {"product_name": "Unbekannt", "board_name": "Unbekannt", "bios_version": "Unbekannt"}
    for key in info:
        path = f"/sys/class/dmi/id/{key}"
        if os.path.exists(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    info[key] = f.read().strip()
            except Exception:
                pass
    return info

def get_cpu_info():
    model = "Intel Core Prozessor"
    cores = os.cpu_count() or 4
    if os.path.exists("/proc/cpuinfo"):
        try:
            with open("/proc/cpuinfo", "r", encoding="utf-8") as f:
                for line in f:
                    if "model name" in line:
                        model = line.split(":", 1)[1].strip()
                        break
        except Exception:
            pass
    return f"{model} ({cores} Kerne / Threads)"

def get_memory_info():
    mem_total, mem_avail = 0, 0
    if os.path.exists("/proc/meminfo"):
        try:
            with open("/proc/meminfo", "r", encoding="utf-8") as f:
                for line in f:
                    parts = line.split(":")
                    if parts[0] == "MemTotal":
                        mem_total = int(parts[1].replace("kB", "").strip())
                    elif parts[0] == "MemAvailable":
                        mem_avail = int(parts[1].replace("kB", "").strip())
        except Exception:
            pass
    if mem_total > 0:
        mem_used = mem_total - mem_avail
        used_gb = mem_used / (1024 * 1024)
        total_gb = mem_total / (1024 * 1024)
        pct = (mem_used / mem_total) * 100
        return f"{used_gb:.1f} GB von {total_gb:.1f} GB belegt ({pct:.0f}%)", pct / 100.0
    return "N/A", 0.0

def get_disk_info():
    try:
        st = os.statvfs("/")
        total = (st.f_blocks * st.f_frsize) / (1024**3)
        avail = (st.f_bavail * st.f_frsize) / (1024**3)
        used = total - avail
        pct = (used / total) * 100 if total > 0 else 0
        return f"{used:.1f} GB von {total:.1f} GB ({pct:.0f}%)", pct / 100.0
    except Exception:
        return "N/A", 0.0

def get_gpu_status():
    lspci_out = run_cmd(["lspci", "-nn"])
    intel_found = "Intel" in lspci_out and ("0116" in lspci_out or "0126" in lspci_out or "HD Graphics 3000" in lspci_out or "VGA" in lspci_out)
    amd_found = any(x in lspci_out.lower() for x in ["radeon", "amd", "1002:6741", "1002:6760"])
    
    lsmod_out = run_cmd(["lsmod"])
    i915_loaded = "i915" in lsmod_out
    radeon_loaded = "radeon" in lsmod_out
    amdgpu_loaded = "amdgpu" in lsmod_out

    efivar_path = "/sys/firmware/efi/efivars/gpu-power-prefs-fa4ce28d-b62f-4c99-9cc3-6815686e30f9"
    efi_mode = "Nicht gesetzt (Standard: AMD aktiv)"
    if os.path.exists(efivar_path):
        try:
            with open(efivar_path, "rb") as f:
                data = f.read()
                if len(data) >= 5:
                    val = data[4]
                    if val == 1:
                        efi_mode = "Intel HD 3000 (iGPU) erzwungen (0x01) - Sicher ✓"
                    elif val == 0:
                        efi_mode = "AMD Radeon (dGPU) erzwungen (0x00) - Warnung ✗"
                    else:
                        efi_mode = f"Benutzerdefiniert ({hex(val)})"
        except Exception:
            efi_mode = "Vorhanden (Keine Leseberechtigung, bitte sudo nutzen)"

    return {
        "intel_present": intel_found,
        "amd_present": amd_found,
        "i915_active": i915_loaded,
        "radeon_active": radeon_loaded,
        "amdgpu_active": amdgpu_loaded,
        "efi_mode": efi_mode
    }

def get_firewall_status():
    res = run_cmd(["ufw", "status"])
    if "Status: active" in res:
        return True, "Aktiviert & Geschützt ✓"
    return False, "Inaktiv ✗"

def get_apparmor_status():
    res = run_cmd(["aa-status", "--enabled"])
    return "Aktiv ✓" if res == "" or "apparmor is enabled" in res.lower() else "Nicht aktiv"


